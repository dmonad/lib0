{
  // Type-checks the generated declaration files in dist/ (run by `npm run dist`). Mirrors the
  // consumer-facing compiler settings; declaration emit can produce .d.ts that don't themselves
  // type-check, which `npm run lint` (source-only) would not catch. Standalone (no `extends`) so the
  // base config's `outDir: ./dist` does not auto-exclude the very files we want to check.
  // dist-check/*.js are consumer fixtures type-checked against those declarations: some type-level
  // costs only show up there, see dist-check/consumer.js. There is deliberately no `paths` mapping:
  // `lib0/*` imports resolve through `exports` in package.json (self-reference), as for a consumer.
  // dist/**/*.js are the test files, copied next to the declarations by dist-check/copy-tests.js
  // so that their relative imports resolve to the declarations.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext", "dom"],
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": ["dist/**/*.d.ts", "dist/**/*.js", "dist-check/**/*.js"]
}
